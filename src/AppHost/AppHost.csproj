<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7ec01a7d-72aa-4278-a32e-8e3b1f739768</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <!-- Pinned: the Aspire hosting stack pulls MessagePack 2.5.192, which is
         vulnerable to GHSA-hv8m-jj95-wg3x and GHSA-vh6j-jc39-fggf. 2.5.301 is the
         fix within the same major line. Remove once Aspire resolves it upstream. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Api/Api.csproj" />
  </ItemGroup>

</Project>
